# ── macOS / Windows / Linux OS cruft ──
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editors / IDEs ──
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.*.un~
.aider*
.cursor/

# ── Secrets / credentials ──
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials/

# ── Build / output / cache ──
output/
dist/
build/
.cache/
.next/
.turbo/

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.coverage
.tox/
.venv/
venv/

# ── Node ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# ── Coverage / test artifacts ──
coverage/
.nyc_output/

# ── Logs ──
*.log

# ── Local Claude Code / OMC state (NOT .claude-plugin/, which IS the manifest) ──
.claude/
.claude-cache/
.claude-state/
.omc/

# ── Per-audit output at REPO ROOT only (when this plugin is run inside a project) ──
# Anchored with leading slash so the sample audit under skills/.../sample-audit/ is preserved.
/research/
/competitive-analysis.html
/GEO-AUDIT-REPORT.md
/dashboard.html

# engine artifacts
engine/**/__pycache__/
__pycache__/
*.pyc
